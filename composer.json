{
    "name": "laranail/password-tools",
    "description": "zxcvbn-style password strength scoring (0-4) with a translated feedback catalogue \u2014 a validation rule and a swappable scorer service.",
    "keywords": [
        "laravel",
        "password",
        "password-strength",
        "zxcvbn",
        "security",
        "validation"
    ],
    "homepage": "https://opensource.simtabi.com/products/laranail/password-tools",
    "license": "MIT",
    "authors": [
        {
            "name": "Simtabi LLC",
            "email": "opensource@simtabi.com",
            "homepage": "https://opensource.simtabi.com",
            "role": "Organization"
        },
        {
            "name": "Imani Manyara",
            "email": "imani@simtabi.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "issues": "https://github.com/laranail/password-tools/issues",
        "source": "https://github.com/laranail/password-tools",
        "docs": "https://opensource.simtabi.com/documentation/laranail/password-tools/"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/laranail/package-tools"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/console"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/validation"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/password-history"
        },
        {
            "type": "composer",
            "url": "https://repo.packagist.org",
            "exclude": [
                "laranail/*"
            ]
        },
        {
            "packagist.org": false
        }
    ],
    "require": {
        "php": "^8.4.1 || ^8.5",
        "bjeavons/zxcvbn-php": "^1.4",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "laranail/console": "^0.1",
        "laranail/package-tools": "^0.1"
    },
    "require-dev": {
        "larastan/larastan": "^3.9.3",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^3.0 || ^4.4.5",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.5.8",
        "roave/security-advisories": "dev-latest",
        "laranail/validation": "^0.1",
        "laranail/password-history": "^0.1"
    },
    "suggest": {
        "laranail/validation": "^1.0 \u2014 compose into the fluent password() builder as ->strength().",
        "laranail/password-history": "^0.1 \u2014 reuse prevention for the same password() chain."
    },
    "autoload": {
        "psr-4": {
            "Simtabi\\Laranail\\PasswordTools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simtabi\\Laranail\\PasswordTools\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=2G",
        "format": "@pint-fix",
        "pint": "@php vendor/bin/laranail-pint --test",
        "pint-fix": "@php vendor/bin/laranail-pint --parallel",
        "lint": [
            "@pint",
            "@phpstan"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simtabi\\Laranail\\PasswordTools\\Providers\\PasswordToolsServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
